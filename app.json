{
  "expo": {
    "name": "Stix N Vibes",
    "slug": "stixnvibes-shop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stixnvibes",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070707",
    "ios": {
      "bundleIdentifier": "com.stixnvibes.shop"
    },
    "android": {
      "package": "com.stixnvibes.shop",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#070707",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "shop.stixnvibes.com",
              "pathPrefix": "/shop"
            },
            {
              "scheme": "https",
              "host": "shop.stixnvibes.com",
              "pathPrefix": "/order"
            },
            {
              "scheme": "https",
              "host": "shop.stixnvibes.com",
              "pathPrefix": "/c/"
            },
            {
              "scheme": "https",
              "host": "shop.stixnvibes.com",
              "pathPrefix": "/collections"
            },
            {
              "scheme": "https",
              "host": "shop.stixnvibes.com",
              "pathPrefix": "/bundle"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a photo or design to print on your order.",
          "cameraPermission": "Take a photo to print on your order.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070707",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "./plugins/with-release-signing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
